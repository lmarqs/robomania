#!/usr/bin/env bash
#MISE description="Compile every sketch with each of its sketch.yaml profiles, stopping at the first that fails"
set -euo pipefail

# Sketches sit at sketches/<name> or sketches/<project>/<variant>; a pattern that matches nothing expands to nothing.
shopt -s nullglob
configs=(sketches/*/sketch.yaml sketches/*/*/sketch.yaml)
if ((${#configs[@]} == 0)); then
  echo "No sketch.yaml under sketches/: run from the repository root." >&2
  exit 1
fi
for config in "${configs[@]}"; do
  sketch="$(dirname "${config}")"
  mise run arduino:compile "${sketch}"
  default="$(yq '.default_profile' "${config}")"
  for profile in $(yq '.profiles | keys | .[]' "${config}"); do
    if [[ "${profile}" != "${default}" ]]; then
      echo "== ${sketch} --profile ${profile}"
      arduino-cli compile "${sketch}" --profile "${profile}" --build-path ".build/${sketch}/${profile}"
    fi
  done
done
