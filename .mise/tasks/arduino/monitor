#!/usr/bin/env bash
#MISE description="Open the serial monitor; Ctrl+] quits"
#USAGE flag "-p --port <port>" env="PORT" help="Serial port of the board"
#USAGE flag "--baudrate <baudrate>" default="115200"
set -euo pipefail

# arduino-cli finds no serial monitor while the cores are installed only per sketch profile, so pyserial's runs.
python3 -m serial.tools.miniterm "${usage_port}" "${usage_baudrate}" --raw
